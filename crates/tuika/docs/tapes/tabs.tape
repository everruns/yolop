# Recorded by crates/tuika/docs/generate.sh — regenerate, don't hand-edit.
# Run from the repository root after `cargo build -p tuika --example demo`.
Output crates/tuika/docs/demos/tabs.gif

Set Shell bash
Set FontSize 20
Set Width 880
Set Height 282
Set Padding 20
Set Framerate 20

Hide
